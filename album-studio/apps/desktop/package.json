{
  "name": "album-studio-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "电子相册工作室桌面应用",
  "main": "./out/main/index.js",
  "author": "Album Studio",
  "scripts": {
    "format": "prettier --write .",
    "download:models": "node scripts/download-models.mjs",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run download:models && npm run build && electron-builder --dir",
    "build:win": "npm run download:models && npm run build && electron-builder --win --x64",
    "build:mac": "npm run download:models && npm run build && electron-builder --mac --universal",
    "verify:package": "node scripts/verify-packaged.mjs",
    "test": "vitest run && node --test scripts/download-models.test.mjs scripts/package-integrity.test.mjs ../../scripts/dev.test.mjs",
    "test:watch": "vitest",
    "test:dev-smoke": "node scripts/dev-smoke.mjs",
    "test:e2e": "npm run build && playwright test smoke.spec.ts",
    "test:e2e:packaged": "npm run build:unpack && playwright test packaged-erase.spec.ts brush-alignment.spec.ts"
  },
  "dependencies": {
    "onnxruntime-node": "1.23.2",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@album-studio/common": "file:../../packages/common",
    "@album-studio/studio": "file:../../packages/studio",
    "@electron-toolkit/utils": "4.0.0",
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
