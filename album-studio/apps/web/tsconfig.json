{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../packages/studio/src/*"],
      "@album-studio/common": ["../../packages/common/src/index.ts"],
      "@album-studio/studio": ["../../packages/studio/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/studio/src"]
}
